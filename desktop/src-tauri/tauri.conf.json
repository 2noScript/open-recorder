{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Recorder",
  "version": "0.1.0",
  "identifier": "com.openrecorder.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Open Recorder",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Open Recorder Overlay",
        "url": "/?window=overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
